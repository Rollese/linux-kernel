 	mutex_init(&aconnector->handle_mst_msg_ready);
@@ -3724,7 +3728,7 @@ static bool parse_edid_cea(struct amdgpu_dm_connector *aconnector,
 	return ret;
 }
 
-STATIC_IFN_KUNIT void parse_edid_displayid_vrr(struct drm_connector *connector,
+STATIC_IFN_KUNIT void parse_edid_displayid_vrr(struct amdgpu_dm_connector *aconn,
 				     const struct edid *edid)
 {
 	u8 *edid_ext = NULL;
@@ -3757,8 +3761,8 @@ STATIC_IFN_KUNIT void parse_edid_displayid_vrr(struct drm_connector *connector,
 				max_vfreq = edid_ext[j+10];
 
 			if (max_vfreq && min_vfreq) {
-				connector->display_info.monitor_range.max_vfreq = max_vfreq;
-				connector->display_info.monitor_range.min_vfreq = min_vfreq;
+				aconn->max_vfreq = max_vfreq;
+				aconn->min_vfreq = min_vfreq;
 
 				return;
 			}
