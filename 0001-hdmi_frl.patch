+		int hdmi_hpo_inst)
+{
+	/* enabled to select one of the DTBCLKs for pipe */
+	if (src == REFCLK)
+		dccg31_disable_hdmistreamclk(dccg, hdmi_hpo_inst);
+	else
+		dccg31_enable_hdmistreamclk(dccg, otg_inst, hdmi_hpo_inst);
