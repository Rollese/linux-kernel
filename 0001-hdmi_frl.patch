 	if (edid && (sink->sink_signal == SIGNAL_TYPE_DISPLAY_PORT ||
 		     sink->sink_signal == SIGNAL_TYPE_EDP)) {
@@ -3912,10 +3916,10 @@ void amdgpu_dm_update_freesync_caps(struct drm_connector *connector,
 		}
 	}
 
-	if (amdgpu_dm_connector->dc_link)
-		as_type = dm_get_adaptive_sync_support_type(amdgpu_dm_connector->dc_link);
+	pcon_allowed = amdgpu_dm_connector->dc_link &&
+		dm_helpers_is_vrr_pcon_compatible(amdgpu_dm_connector->dc_link, connector->dev);
 
-	if (as_type == FREESYNC_TYPE_PCON_IN_WHITELIST) {
+	if (pcon_allowed) {
 		i = parse_hdmi_amd_vsdb(amdgpu_dm_connector, edid, &vsdb_info);
 		if (i >= 0) {
 			amdgpu_dm_connector->vsdb_info = vsdb_info;
@@ -3923,7 +3927,7 @@ void amdgpu_dm_update_freesync_caps(struct drm_connector *connector,
 
 			if (vsdb_info.freesync_supported && vsdb_info.amd_vsdb_version > 0) {
 				amdgpu_dm_connector->pack_sdp_v1_3 = true;
-				amdgpu_dm_connector->as_type = as_type;
+				amdgpu_dm_connector->as_type = ADAPTIVE_SYNC_TYPE_PCON_ALLOWED;
 
 				amdgpu_dm_connector->min_vfreq = vsdb_info.min_refresh_rate_hz;
 				amdgpu_dm_connector->max_vfreq = vsdb_info.max_refresh_rate_hz;
@@ -3941,7 +3945,7 @@ void amdgpu_dm_update_freesync_caps(struct drm_connector *connector,
 		dm_helpers_read_mccs_caps(adev->dm.dc->ctx, amdgpu_dm_connector->dc_link, sink);
 
 	if ((sink->sink_signal == SIGNAL_TYPE_HDMI_TYPE_A ||
-		as_type == FREESYNC_TYPE_PCON_IN_WHITELIST) &&
+		pcon_allowed) &&
 		(!sink->edid_caps.freesync_vcp_code ||
 		(sink->edid_caps.freesync_vcp_code && !sink->mccs_caps.freesync_supported)))
 		freesync_capable = false;
@@ -3962,4 +3966,5 @@ void amdgpu_dm_update_freesync_caps(struct drm_connector *connector,
 	if (connector->vrr_capable_property)
 		drm_connector_set_vrr_capable_property(connector,
 						       freesync_capable);
+
 }
