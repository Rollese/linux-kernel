index 000000000000..0edb3dc06a69
--- /dev/null
+++ b/drivers/gpu/drm/amd/ras/ras_mgr/amdgpu_ras_mce.c
@@ -0,0 +1,267 @@
+// SPDX-License-Identifier: MIT
+/*
